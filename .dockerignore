# ######################################################################
# # Archivo .gitignore para un proyecto de IA Generativa con RAG       #
# # Stack: FastAPI, React (Vite), Ollama, ChromaDB, Docker             #
# ######################################################################

# ----------------------------------------------------------------------
# SECCIÓN CRÍTICA: Secretos, claves de API y archivos de entorno
# NUNCA subas estos archivos a tu repositorio.
# ----------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets.yaml

# Archivos de entorno local específicos de Vite/React
.env.local
.env.development.local
.env.production.local
.env.test.local

.gitignore

# ----------------------------------------------------------------------
# Python / FastAPI Backend
# ----------------------------------------------------------------------
# Entornos virtuales
venv/
.venv/
env/
.env/
pyvenv.cfg
pip-selfcheck.json

# Caché y archivos compilados de Python
__pycache__/
*.pyc
*.pyo
*.pyd
__init__.py

# Archivos de distribución y empaquetado
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Caché de Pytest
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Bases de datos locales (ej. para pruebas)
*.sqlite3
*.db
instance/


# ----------------------------------------------------------------------
# Node.js / React (Vite) Frontend
# ----------------------------------------------------------------------
# Dependencias
node_modules/

# Archivos de build y salida
dist/
.vite/
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos temporales del sistema de compilación
.temp


# ----------------------------------------------------------------------
# IA, LLMs y Datos - MUY IMPORTANTE
# ----------------------------------------------------------------------
# Bases de datos de vectores (ChromaDB por defecto guarda aquí)
.chroma/
chroma_db/

# Modelos de LLMs descargados (ej. si configuras Ollama para guardar en el proyecto)
# Los modelos de Ollama pueden pesar GIGAS. Asegúrate de que no se suban.
ollama_models/

# Datasets descargados (PDFs de arXiv, noticias, etc.)
# No queremos los datos crudos en el repositorio, solo los scripts para obtenerlos.
data/
datasets/
pdfs/
*.pdf
*.csv
*.jsonl


# ----------------------------------------------------------------------
# Docker
# ----------------------------------------------------------------------
# Aunque docker-compose.yml debe estar en el repo, los archivos generados
# localmente por Docker (builds, logs) no deben estarlo.
# La mayoría de estos no estarán en tu directorio de proyecto, pero es una buena práctica.
docker-compose.override.yml
docker-compose.local.yml


# ----------------------------------------------------------------------
# Configuración de IDEs y Editores de Código
# ----------------------------------------------------------------------
.idea/
.vscode/
# Excepción: permite compartir configuraciones recomendadas del editor
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/launch.json
!/.vscode/tasks.json

*.sublime-project
*.sublime-workspace
nbproject/
*.swp


# ----------------------------------------------------------------------
# Archivos de Sistema Operativo
# ----------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/