# ==============================================================================
# Content GenerAItor - Archivo de Ejemplo de Variables de Entorno (.env.example)
# Copia este archivo a `.env` en la raíz del proyecto y completa con tus valores.
# NUNCA incluyas claves de API reales en este archivo de ejemplo.
# ==============================================================================

# --- Configuración General de la Aplicación ---
ENVIRONMENT=production
APP_NAME=Content GenerAItor

# --- Seguridad y Nivel de Logging ---
# Opciones para LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
# En INFO o superior, los logs NO registran en texto plano el contenido de entradas de usuario.
LOG_LEVEL=INFO

# --- Orígenes Permitidos por CORS (separados por comas) ---
CORS_ORIGINS=http://localhost:5173,http://localhost

# --- Control de Acceso y Rate Limiting ---
# Límite de peticiones por minuto por IP para endpoints POST de IA (0 para desactivar)
RATE_LIMIT_PER_MINUTE=60
# Clave API opcional requerida en la cabecera 'X-API-Key' (vacío para desactivar en local)
API_KEY=

# --- API Keys de Servicios Externos ---
GOOGLE_API_KEY=changeme
UNSPLASH_ACCESS_KEY=changeme
TAVILY_API_KEY=changeme

# --- Configuración de Ollama (Host para conexión desde Docker o local) ---
# En Docker (Mac/Windows): http://host.docker.internal:11434
# En desarrollo local (sin Docker): http://localhost:11434
OLLAMA_HOST=http://host.docker.internal:11434

# --- Observabilidad con LangSmith (Opcional, desactivado por defecto) ---
# AVISO DE PRIVACIDAD: Si se activa (true), los prompts, entradas del usuario y
# respuestas generadas se transmitirán a los servidores externos de LangChain.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=changeme
LANGCHAIN_PROJECT=GenerAItor Sprint

# --- Frontend (Vite) ---
# Opcional en desarrollo local fuera de Docker si se desea apuntar a otro host/puerto
VITE_API_BASE_URL=http://localhost:8000
